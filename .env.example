# Copy to .env and replace every value. .env is git-ignored - never commit it.
# Generate random secrets with e.g.:  openssl rand -base64 48

# --- PostgreSQL (incident tracker database) ---
POSTGRES_USER=soc_app
POSTGRES_PASSWORD=change-me-postgres

# --- target-app ---
# HMAC key for signing JWTs: at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
DEMO_ALICE_PASSWORD=change-me-alice
DEMO_BOB_PASSWORD=change-me-bob
DEMO_ADMIN_PASSWORD=change-me-admin
TRUST_FORWARDED_FOR=true

# --- service-to-service: detection-service -> incident-tracker (min 16 chars) ---
TRACKER_API_KEY=change-me-tracker-api-key

# --- SOC analyst logins (dashboard, incident-tracker, detection-service) ---
# Users: analyst1, lead
ANALYST1_PASSWORD=change-me-analyst
SOC_LEAD_PASSWORD=change-me-lead

# --- tuning ---
OPENSEARCH_HEAP=512m
# ISO-8601 duration
DETECTION_POLL_INTERVAL=PT15S
TARGET_APP_PORT=8080
DASHBOARD_PORT=3000
